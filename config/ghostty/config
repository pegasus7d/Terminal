# Ghostty config — popular defaults

# --- Appearance ---
theme = Rose Pine Moon
font-family = JetBrainsMono Nerd Font Mono
font-size = 15
window-padding-x = 12
window-padding-y = 12

# --- Transparency + blur (the macOS "frosted glass" look) ---
background-opacity = 0.92
background-blur-radius = 20

# --- Cursor / mouse ---
cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true

# --- macOS behavior ---
macos-option-as-alt = true
macos-titlebar-style = tabs

# --- Quick terminal (drop-down from anywhere) ---
keybind = global:cmd+grave_accent=toggle_quick_terminal

# --- File sidebar: cmd+e opens a left split; type `y` there to launch Yazi ---
keybind = cmd+e=new_split:left
